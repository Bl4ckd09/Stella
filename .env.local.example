# ── Supabase ────────────────────────────────────────────────────────────────
# From Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Direct Postgres connection (Project Settings → Database → Connection string → URI)
# Used by the bulk data-load scripts (COPY) and pg_trgm queries.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.YOUR-PROJECT.supabase.co:5432/postgres

# ── Claude API (LLM for prose) ───────────────────────────────────────────────
# From https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...
# Optional model override (default claude-opus-4-8); claude-haiku-4-5 is cheaper
# ANTHROPIC_MODEL=claude-opus-4-8

# ── Companies House (optional live fallback) ─────────────────────────────────
# Free key from https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_KEY=

# ── ElevenLabs (voice agent) ─────────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Shared secret your /api/voice-lookup checks on inbound webhook calls
VOICE_TOOL_SECRET=change-me-to-a-long-random-string

# ── Voxtral browser voice (the phone path above stays on ElevenLabs) ─────────
# A separate random secret with at least 32 characters. Share it with Modal.
VOICE_SESSION_SECRET=change-me-to-another-long-random-string
# The public Modal gateway URL. The browser receives it only with a signed token.
VOXTRAL_GATEWAY_URL=https://YOUR-WORKSPACE--stella-voxtral-gateway-gateway.modal.run
# These values support local contract and prewarm commands. Vercel does not need them.
NEBIUS_API_KEY=
NEBIUS_VOICE_MODEL=Qwen/Qwen3.6-27B
VOXTRAL_STT_URL=https://YOUR-WORKSPACE--stella-voxtral-stt-serve.modal.run
VOXTRAL_TTS_URL=https://YOUR-WORKSPACE--stella-voxtral-tts-serve.modal.run
MODAL_PROXY_KEY=
MODAL_PROXY_SECRET=

# ── Twilio (phone number for the ElevenLabs agent) ───────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
