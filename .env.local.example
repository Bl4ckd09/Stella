# ── Supabase ────────────────────────────────────────────────────────────────
# From Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Direct Postgres connection (Project Settings → Database → Connection string → URI)
# Used by the bulk data-load scripts (COPY) and pg_trgm queries.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.YOUR-PROJECT.supabase.co:5432/postgres

# ── Claude API (LLM for prose) ───────────────────────────────────────────────
# From https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...
# Optional model override (default claude-opus-4-8); claude-haiku-4-5 is cheaper
# ANTHROPIC_MODEL=claude-opus-4-8

# ── Companies House (optional live fallback) ─────────────────────────────────
# Free key from https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_KEY=

# ── ElevenLabs (voice agent) ─────────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Shared secret your /api/voice-lookup checks on inbound webhook calls
VOICE_TOOL_SECRET=change-me-to-a-long-random-string

# ── Mistral web voice agent ──────────────────────────────────────────────────
# Mistral API key for Voxtral STT/TTS and the Mistral-native web voice agent.
MISTRAL_API_KEY=
# Optional saved Voxtral TTS voice id; unset to use Mistral's default voice.
MISTRAL_TTS_VOICE_ID=
# Default web voice provider; set to "elevenlabs" to restore the old Convai widget.
NEXT_PUBLIC_VOICE_PROVIDER=mistral

# ── Twilio (phone number for the ElevenLabs agent) ───────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Stella Autonomous (Hands-Off HQ) ─────────────────────────────────────────
# The AI workforce reasons with a fast/cheap model by default. Override to
# claude-opus-4-8 for top-quality artifacts (slower, pricier per tick).
# STELLA_AGENT_MODEL=claude-haiku-4-5
# The console runs fully on the deterministic engine + compliance guard with NO
# key set (templated reasoning). Set ANTHROPIC_API_KEY (above) to turn on live
# Claude reasoning via the "AI reasoning" toggle in /hq.

# Production integrations the agents are wired to use (sandbox-ready stubs in the
# demo). Hackathon partners: PayPal payment sandbox + Wassist WhatsApp number.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENV=sandbox
# WASSIST_API_KEY=
# WASSIST_WHATSAPP_NUMBER=

# ── Swappable LLM provider ────────────────────────────────────────────────────
# Default is Claude (ANTHROPIC_API_KEY above). To run the WHOLE app (web letters,
# voice letters, and the agent workforce) on an OpenAI-compatible endpoint such
# as a Modal-hosted model, Nebius, Together, or OpenAI:
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://<your-modal-endpoint>/v1   # Modal serves the OpenAI API under /v1
# LLM_MODEL=Qwen/Qwen3.6-35B-A3B                  # model name = the base model repo ID
# Modal endpoints are authenticated by default with a proxy-token PAIR
# (`modal workspace proxy-tokens create`). Set both:
# MODAL_KEY=wk-...
# MODAL_SECRET=ws-...
# ...or deploy with `--unauthenticated` and leave these blank.
# For non-Modal OpenAI-compatible hosts that use a Bearer token instead:
# LLM_API_KEY=<bearer token>

# ── Qwen Cloud (Alibaba Model Studio / DashScope) ─────────────────────────────
# Two-tier Qwen setup: flagship for customer/council artifacts, flash for the
# high-volume agent loop. Key from home.qwencloud.com/api-keys (Singapore /
# International workspace — other regions have no free quota).
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=sk-...
# STELLA_ARTIFACT_MODEL=qwen3.7-max
# STELLA_AGENT_MODEL=qwen3.6-flash
# Qwen3 hybrid thinking is forced OFF on DashScope hosts; opt back in with:
# QWEN_ENABLE_THINKING=true
