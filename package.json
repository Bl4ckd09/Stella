{
  "name": "stella",
  "version": "0.1.0",
  "private": true,
  "description": "Stella: Unclaimed Business Money Engine",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "load:voa": "tsx scripts/load-voa.ts",
    "load:companies": "tsx scripts/load-companies.ts",
    "db:borough": "tsx scripts/load-boroughs.ts",
    "test:voice": "PYTHONPATH=. .venv/bin/python -m pytest -c voice/pytest.ini voice/tests",
    "voice:contract": "PYTHONPATH=. .venv/bin/python voice/contract_check.py",
    "voice:prewarm": "node scripts/prewarm-voice.mjs",
    "voice:smoke": "PYTHONPATH=. .venv/bin/python voice/smoke_deployed.py",
    "voice:latency": "PYTHONPATH=. .venv/bin/python voice/latency_check.py",
    "voice:deploy": "npm run voice:contract && modal deploy voice/modal_gateway.py",
    "voice:deploy:self-hosted": "VOICE_RUNTIME_MODE=self_hosted npm run voice:contract && modal deploy voice/modal_stt.py && modal deploy voice/modal_tts.py && modal deploy voice/modal_gateway.py"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.69.0",
    "@supabase/supabase-js": "^2.45.0",
    "next": "^16.3.0",
    "pg": "^8.13.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "pg-copy-streams": "^6.0.6",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^4.1.10"
  }
}
